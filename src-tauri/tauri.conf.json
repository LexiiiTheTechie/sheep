{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sheep",
  "version": "0.1.0",
  "identifier": "tech.lexiii.sheep",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["shell"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Sheep - native desktop shell for TextGen",
    "longDescription": "Sheep runs the TextGen engine and shows its native UI. It replaces the Electron wrapper and provides strict user isolation with native performance.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
